# Supabase Public Configuration
VITE_SUPABASE_URL=https://xcwizfrvceacokchguwz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Application Public URLs
