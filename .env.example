# Cloudflare Prod:    VITE_SITE_URL=https://codershub-kqi.pages.dev
VITE_SITE_URL=https://codershub-kqi.pages.dev

# Public GitHub App Client ID (Safe in browser; used to initiate OAuth redirect if called directly)
